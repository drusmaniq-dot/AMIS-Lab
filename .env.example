# Copy this file to .env and fill in real values. .env is gitignored.

DATABASE_URL="postgresql://user:password@localhost:5432/amis_lab?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# Google OAuth ("Sign in with Google") — optional. Create an OAuth 2.0 Client
# ID at https://console.cloud.google.com/apis/credentials (Application type:
# Web application), authorized redirect URI {NEXTAUTH_URL}/api/auth/callback/google.
# Leave blank to disable; email/password login keeps working either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "local" (dev, writes to public/uploads — not viable on Vercel) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Used by prisma/seed.ts to create the first admin account
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Plant-Growth service proxy (app/dashboard/services/plant-growth) — the
# vendored Flask app at plant-growth/ is started automatically alongside
# Next.js by `npm run dev:full` / `npm run start:full` (see
# scripts/start-with-plant-growth.mjs), bound to 127.0.0.1 only. Reverse-
# proxied so it's reachable only through AMIS Lab's own auth +
# service-access gate, never directly.
PLANT_GROWTH_SERVICE_URL="http://127.0.0.1:8091"
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
PLANT_GROWTH_PROXY_SECRET=""
PLANT_GROWTH_INTERNAL_PORT="8091"
