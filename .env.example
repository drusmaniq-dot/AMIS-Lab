# Copy this file to .env and fill in real values. .env is gitignored.

DATABASE_URL="postgresql://user:password@localhost:5432/amis_lab?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3002"

# Google OAuth ("Sign in with Google") — optional. Create an OAuth 2.0 Client
# ID at https://console.cloud.google.com/apis/credentials (Application type:
# Web application), authorized redirect URI {NEXTAUTH_URL}/api/auth/callback/google.
# Leave blank to disable; email/password login keeps working either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# "local" (dev, writes to public/uploads — not viable on Vercel) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Used by prisma/seed.ts to create the first admin account
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Plant-Growth service proxy (app/dashboard/services/plant-growth) — internal
# Flask app (separate repo), reverse-proxied so it's reachable only through
# AMIS Lab's own auth + service-access gate, never directly. Must match the
# PROXY_SHARED_SECRET set on that deployment.
PLANT_GROWTH_SERVICE_URL=""
PLANT_GROWTH_PROXY_SECRET=""
